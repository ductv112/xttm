// XTTMQG — Hệ thống Quản lý Chương trình Quốc gia về Xúc tiến Thương mại
// Schema lock cho M0 + scaffolding cho phase 2-11
// Theo .planning/research/ARCHITECTURE.md §3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH & RBAC — M0 (AUTH-02)
// =============================================================================

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  fullName       String
  email          String?
  phone          String?
  role           String // ADMIN | BANQL | CHUYENVIEN | HOIDONG | DONVI | TAICHINH | LANHDAO
  isActive       Boolean  @default(true)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  scoreSheets   ScoreSheet[]
  auditLogs     AuditLog[]
  uploadedFiles Attachment[]  @relation("AttachmentUploader")

  @@index([organizationId])
  @@index([role])
}

// Permissions managed at app layer via lib/permissions.ts MATRIX.
// These models scaffold M1 role/permission matrix UI (Phase 2) so schema doesn't refactor.
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ADMIN | BANQL | CHUYENVIEN | HOIDONG | DONVI | TAICHINH | LANHDAO
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique // resource:action  e.g. "de-an:create"
  resource String
  action   String
  name     String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  granted      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// =============================================================================
// ORGANIZATION — M0 partial (3-5 seed orgs); full M2.2 (AUTH-02 needs Cục XTTM)
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  code      String   @unique // CUC_XTTM | BO_CT | VITAS | LEFASO | VINATEX | ...
  name      String
  type      String // ASSOCIATION | RESEARCH_INSTITUTE | ENTERPRISE | GOVERNMENT | OTHER
  taxCode   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  isInvited Boolean  @default(false)
  searchKey String // diacritics-removed cho Vietnamese search
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  profile   OrganizationProfile?
  projects  Project[]
  contracts Contract[]

  @@index([type])
  @@index([searchKey])
}

// Phase 4 (M2.2) — Hồ sơ Đơn vị Chủ trì.
// JSON-backed pattern (consistent với ProgramCycle.configJson + Project.marketIds):
//   legalInfoJson  : { taxCode, address, representativeName, representativeTitle, businessType, businessField }
//   capabilitiesJson: { description (Tiptap HTML), achievements (string), pastProjects: [{ name, year, outcome }] }
//   contactsJson   : [{ name, title, role, email, phone }]  -- min 1 contact required at submit
// State machine: lib/workflows/orgProfile.ts (DRAFT → SUBMITTED → APPROVED/REJECTED ⇄ DRAFT).
model OrganizationProfile {
  id               String    @id @default(cuid())
  organizationId   String    @unique
  legalInfoJson    String? // JSON: legal info object
  capabilitiesJson String? // JSON: capabilities object
  contactsJson     String? // JSON: array of contact objects
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  rejectionReason  String? // populated when status=REJECTED (BQL fills in)
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

// =============================================================================
// PROGRAM CYCLE — Scaffold for Phase 3 (M2.1 HERO)
// =============================================================================

model ProgramCycle {
  id                           String    @id @default(cuid())
  year                         Int       @unique // 1 chu kỳ / năm
  name                         String
  status                       String    @default("DRAFT") // DRAFT | READY | OPEN_REGISTRATION | CLOSED_REGISTRATION | EVALUATING | APPROVED | COMPLETED
  totalBudget                  Float? // VND, SQLite REAL
  registrationOpenAt           DateTime?
  registrationCloseAt          DateTime? // mặc định 30/5
  supplementDeadline           DateTime? // CYCLE-03 hạn nộp bổ sung
  evaluationStartAt            DateTime?
  evaluationEndAt              DateTime?
  approvalDeadline             DateTime?
  scanDocumentUrl              String?
  emailTemplateId              String?
  invitationLetterAttachmentId String? // FK to Attachment uploaded as công văn ban hành
  invitedOrganizations         String? // JSON array of organizationIds
  configJson                   String? // JSON: scoringCriteriaIds + evaluationCriteriaIds + emailTemplateIds + extendReason history
  createdById                  String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  projects      Project[]
  councils      EvaluationCouncil[]
  notifications Notification[]

  @@index([status])
}

// =============================================================================
// PROJECT — Scaffold for Phase 5 (M2.3 HERO) + Phase 6
// =============================================================================

// Phase 5 (M2.3) — JSON-backed columns store wizard form data:
//   generalInfoJson : { industrySectorIds:[], marketIds:[], countryIds:[],
//                       promotionTypeIds:[], timeRange:{ start, end, quarter } }
//   objectivesJson  : { objective: <html>, content: <html> }
//   planJson        : { rows: [{ task, deliverable, dueDate, owner }] }
//   budgetJson      : { rows: [{ item, unit, quantity, unitPrice, amount, source }],
//                       totalState, totalSelf, total }
// pmContactId references an OrganizationProfile contact (UUID stored in contactsJson).
// year: standalone Int — đề án 2 năm uses parentProjectId + (year+1) record TENTATIVE.
// State machine: lib/workflows/project.ts DRAFT → SUBMITTED → ASSIGNED → IN_REVIEW →
//   (SUPPLEMENT_REQUIRED → RESUBMITTED → IN_REVIEW)* → VALID → EVALUATING → APPROVED →
//   IN_PROGRESS → COMPLETED. SUBMITTED → DRAFT (rút) when not yet assigned.
//   TENTATIVE = đề án 2 năm year+1 placeholder.
model Project {
  id                      String    @id @default(cuid())
  code                    String    @unique // XTTM-2026-001
  programCycleId          String
  organizationId          String
  parentProjectId         String? // Đề án 2 năm — link tới năm 1 (per PITFALLS §4.2)
  name                    String
  year                    Int       @default(0) // năm thực hiện (đề án 2 năm: parent.year + 1)
  kind                    String // EXPORT_EXHIBITION | INTL_CONFERENCE | DOMESTIC_FAIR | TRADE_DELEGATION_OUT | TRADE_DELEGATION_IN | TRADE_INFO_EXPORT | TRADE_INFO_DOMESTIC | TRAINING | OTHER
  // Phase 5 wizard JSON columns
  generalInfoJson         String? // JSON: industrySectorIds + marketIds + countryIds + promotionTypeIds + timeRange
  objectivesJson          String? // JSON: { objective: html, content: html }
  planJson                String? // JSON: { rows: [{task,deliverable,dueDate,owner}] }
  budgetJson              String? // JSON: { rows, totalState, totalSelf, total }
  pmContactId             String? // contact UUID (from OrganizationProfile.contactsJson)
  // Legacy scaffolded scalar columns (M0) — co-exist; UI prefers JSON
  industrySectorId        String?
  promotionTypeId         String?
  marketIds               String? // JSON array (M0 legacy)
  countryIds              String? // JSON array (M0 legacy)
  objective               String?
  description             String?
  expectedOutcome         String?
  plannedStartAt          DateTime?
  plannedEndAt            DateTime?
  location                String?
  proposedBudget          Float?
  approvedBudget          Float?
  managerName             String?
  managerTitle            String?
  managerPhone            String?
  managerEmail            String?
  status                  String    @default("DRAFT") // see lib/workflows/project.ts
  currentVersion          Int       @default(1)
  submittedAt             DateTime?
  receivedAt              DateTime?
  assignedReviewerId      String? // alias: assignedToUserId
  // Phase 6 (M2.4) intake metadata
  assignedAt              DateTime? // BQL/LĐ phân công cho chuyên viên thời điểm nào
  assignedById            String? // user id của BQL/LĐ phân công
  checklistJson           String? // JSON: [{ itemId, status: '✓'|'✗'|'N/A', note }]
  passedFormalCheck       Boolean   @default(false) // chuyên viên xác nhận hợp lệ
  formalRejectionReason   String? // lý do loại từ vòng kiểm tra hành chính
  supplementRequestReason String? // lý do trả bổ sung mới nhất
  // Phase 8 (M4) — Triển khai (IMPL-01..12)
  // implementationJson stores: { milestones: [{id,title,startDate,endDate,owner,progress,note}], staff: [{name,role,phone,email}], schedule: {start,end,note} }
  implementationJson      String? // JSON: kế hoạch triển khai
  contactedConsulate      Boolean   @default(false) // đã liên hệ Thương vụ ĐSQ chưa
  consulateContactJson    String? // JSON: { country, contactName, contactDate, contactInfo, attachmentId }
  searchKey               String    @default("") // diacritics-removed
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  programCycle      ProgramCycle       @relation(fields: [programCycleId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  parent            Project?           @relation("ProjectYearLink", fields: [parentProjectId], references: [id])
  childProjects     Project[]          @relation("ProjectYearLink")
  scoreSheets       ScoreSheet[]
  contract          Contract?
  reports           Report[]
  versions          ProjectVersion[]
  amendments        ProjectAmendment[]
  acceptanceRecords AcceptanceRecord[]

  @@index([programCycleId, status])
  @@index([organizationId])
  @@index([assignedReviewerId])
  @@index([searchKey])
  @@index([year])
  @@index([parentProjectId])
}

// Phase 5 (M2.3) — ProjectVersion snapshot.
// Captures full project snapshot before each resubmit (PROJ-20..22 lịch sử bổ sung).
// snapshotJson stores the entire Project payload (incl. JSON columns) at submit time.
model ProjectVersion {
  id            String   @id @default(cuid())
  projectId     String
  versionNumber Int
  snapshotJson  String // JSON: serialized project state at snapshot time
  reason        String? // optional: why a new version (eg "Bổ sung theo yêu cầu BQL")
  createdById   String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId, createdAt])
}

// =============================================================================
// EVALUATION — Scaffold for Phase 7 (M3 HERO)
// =============================================================================

// Phase 7 (M3) — EvaluationCouncil extended với term, lockStatus, createdById,
// members[], assignments[]. Status retained cho backward compat (DRAFT|OPEN|CLOSED)
// nhưng business chủ yếu dựa vào lockStatus (OPEN|LOCKED) per plan decisions.
model EvaluationCouncil {
  id             String    @id @default(cuid())
  programCycleId String
  name           String
  term           String    @default("Lần 1") // Lần 1 | Lần 2 | ...
  decisionDocUrl String?
  status         String    @default("DRAFT") // DRAFT | OPEN | CLOSED — legacy field
  lockStatus     String    @default("OPEN") // OPEN | LOCKED — Phase 7 working state
  openAt         DateTime?
  closeAt        DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  programCycle ProgramCycle               @relation(fields: [programCycleId], references: [id])
  scoreSheets  ScoreSheet[]
  members      CouncilMember[]
  assignments  ProjectCouncilAssignment[]

  @@index([programCycleId, lockStatus])
}

// Phase 7 — Thành viên hội đồng thẩm định.
// roles: CHU_TICH | PHO | UY_VIEN | THU_KY (per CONTEXT.md decisions).
model CouncilMember {
  id        String   @id @default(cuid())
  councilId String
  userId    String
  role      String // CHU_TICH | PHO | UY_VIEN | THU_KY
  joinedAt  DateTime @default(now())

  council EvaluationCouncil @relation(fields: [councilId], references: [id], onDelete: Cascade)

  @@unique([councilId, userId])
  @@index([councilId])
  @@index([userId])
}

// Phase 7 — Phân công đề án vào hội đồng (many-to-many).
// Khi tạo assignment, project transitions VALID → EVALUATING.
model ProjectCouncilAssignment {
  id         String   @id @default(cuid())
  councilId  String
  projectId  String
  assignedAt DateTime @default(now())

  council EvaluationCouncil @relation(fields: [councilId], references: [id], onDelete: Cascade)

  @@unique([councilId, projectId])
  @@index([councilId])
  @@index([projectId])
}

// Phase 7-02 (Approval) — Tờ trình BQL gửi Bộ phê duyệt.
// projectIdsJson: JSON array of selected project ids (sorted by aggregate score desc).
// contentHtml: Tiptap rich text body của tờ trình (auto-fill từ template DocumentTemplate.code='TO_TRINH').
// status: DRAFT (đang soạn) | SUBMITTED_TO_BO (đã gửi cho Bộ).
model SubmissionDraft {
  id              String    @id @default(cuid())
  programCycleId  String
  councilId       String? // có thể tổng hợp từ nhiều council
  draftNumber     String? // Số tờ trình (vd 12/TTr-XTTM)
  draftedAt       DateTime  @default(now())
  draftedById     String
  projectIdsJson  String // JSON array of project ids
  contentHtml     String // Tiptap HTML
  status          String    @default("DRAFT") // DRAFT | SUBMITTED_TO_BO
  submittedToBoAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  decision ApprovalDecision?

  @@index([programCycleId])
  @@index([status])
  @@index([draftedAt])
}

// Phase 7-02 (Approval) — Quyết định phê duyệt từ Bộ.
// approvedItemsJson: JSON array of { projectId, approvedBudget, comments } cho mỗi đề án phê duyệt.
// totalApprovedBudget: tổng kinh phí được duyệt (sum of approvedItems.approvedBudget).
// 1:1 với SubmissionDraft (FK unique).
model ApprovalDecision {
  id                  String   @id @default(cuid())
  submissionId        String   @unique
  decisionNumber      String // Số quyết định (vd 1234/QĐ-BCT)
  decisionDate        DateTime
  signedByName        String
  signedByTitle       String
  approvedItemsJson   String // JSON: [{projectId, approvedBudget, comments?}]
  totalApprovedBudget Float
  scanFileUrl         String? // optional: bản scan QĐ
  notes               String?
  createdAt           DateTime @default(now())
  createdById         String?

  submission SubmissionDraft @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([decisionDate])
}

model ScoreSheet {
  id                 String    @id @default(cuid())
  councilId          String? // null khi kind=PRELIMINARY (chấm điểm sơ bộ trước khi lập hội đồng)
  projectId          String
  reviewerId         String
  kind               String    @default("EVALUATION") // PRELIMINARY (chuyên viên chấm sơ bộ Phase 6) | EVALUATION (hội đồng thẩm định Phase 7)
  status             String    @default("DRAFT") // DRAFT | SUBMITTED
  scoresJson         String? // JSON [{criterionId, score, weight, comment}]
  totalScore         Float?
  comment            String?
  conflictOfInterest Boolean   @default(false)
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  council  EvaluationCouncil? @relation(fields: [councilId], references: [id])
  project  Project            @relation(fields: [projectId], references: [id])
  reviewer User               @relation(fields: [reviewerId], references: [id])

  @@unique([projectId, reviewerId, kind])
  @@index([kind, status])
  @@index([projectId, kind])
}

// =============================================================================
// CONTRACT — Phase 8 (M4) Hợp đồng quản lý
// =============================================================================

// Phase 8 (M4) — Hợp đồng được sinh tự động từ đề án APPROVED.
// Số HĐ format XTTM/YYYY/NNN, atomic running counter per year.
// Status machine: DRAFT → SIGNED → IN_PROGRESS → COMPLETED → LIQUIDATED.
// Cảnh báo 60 ngày sau quyết định phê duyệt mà vẫn chưa SIGNED.
model Contract {
  id             String    @id @default(cuid())
  projectId      String    @unique
  organizationId String
  contractNo     String    @unique // XTTM/2026/001
  signedDate     DateTime?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  totalValue     Float
  status         String    @default("DRAFT") // DRAFT | SIGNED | IN_PROGRESS | COMPLETED | LIQUIDATED
  scanFileUrl    String?
  termsHtml      String? // Tiptap HTML — điều khoản hợp đồng
  signedById     String? // User.id của người ký từ phía Cục XTTM
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([signedDate])
}

// =============================================================================
// PROJECT AMENDMENT — Phase 8 (M4) Điều chỉnh đề án (Điều 13 NĐ 28/2018/NĐ-CP)
// =============================================================================

// Phase 8 (M4) — Điều chỉnh đề án theo Điều 13 NĐ 28.
// Loại NHỎ (BQL phê duyệt nội bộ): TIME, LOCATION, UNIT_NAME, PROJECT_NAME, OTHER
// Loại TRỌNG YẾU (yêu cầu thẩm định lại): OBJECTIVE, CONTENT, BUDGET, MARKET
// isCritical computed bởi lib/amendment-rules.isCriticalAmendment().
// Status: PENDING → APPROVED (loại nhỏ) | RESUBMIT_EVALUATION (loại trọng yếu) | REJECTED
// oldValueJson/newValueJson lưu snapshot trường thay đổi (per amendmentType key).
model ProjectAmendment {
  id              String    @id @default(cuid())
  projectId       String
  amendmentType   String // TIME | LOCATION | UNIT_NAME | PROJECT_NAME | OBJECTIVE | CONTENT | BUDGET | MARKET | OTHER
  isCritical      Boolean   @default(false)
  oldValueJson    String? // JSON: snapshot field cũ
  newValueJson    String? // JSON: giá trị mới đề xuất
  reason          String // lý do điều chỉnh (min 50 chars)
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | RESUBMIT_EVALUATION
  decisionNumber  String? // số quyết định điều chỉnh (vd 12/QĐ-XTTM)
  decisionDate    DateTime?
  reviewedById    String? // User.id của BQL phê duyệt / từ chối
  reviewedAt      DateTime?
  reviewerComment String?
  requestedById   String // User.id của đơn vị tạo yêu cầu
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([isCritical])
  @@index([createdAt])
}

// =============================================================================
// REPORT — Phase 9 (M5) Báo cáo kết quả đề án
// =============================================================================

// Phase 9 (M5) — Báo cáo kết quả đề án từ đơn vị chủ trì sau khi triển khai.
// quantitativeJson stores: { rows: [{id, name, unit, planned, actual, note}] }
// qualitativeHtml: Tiptap HTML mô tả định tính kết quả
// State machine: DRAFT → SUBMITTED → APPROVED | RETURNED → SUBMITTED
// Cảnh báo SLA 15 ngày sau hoạt động kết thúc mà chưa nộp báo cáo.
model Report {
  id                       String    @id @default(cuid())
  projectId                String
  title                    String
  reportType               String    @default("FINAL") // PROGRESS | FINAL
  quantitativeJson         String? // JSON: { rows: [{id, name, unit, planned, actual, note}] }
  qualitativeHtml          String? // Tiptap HTML
  attendingCompaniesCount  Int? // số DN tham gia (cảnh báo doanh thu/HĐ)
  status                   String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | RETURNED
  submittedAt              DateTime?
  reviewedById             String?
  reviewedAt               DateTime?
  reviewComments           String?
  dueAt                    DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  project          Project           @relation(fields: [projectId], references: [id])
  acceptanceRecord AcceptanceRecord?

  @@index([projectId])
  @@index([status])
}

// =============================================================================
// ACCEPTANCE RECORD — Phase 9 (M5) Biên bản nghiệm thu
// =============================================================================

// Phase 9 (M5) — Biên bản nghiệm thu sau khi báo cáo APPROVED.
// BQL lập biên bản, sinh PDF, in + ký tay → upload bản scan.
// result: PASS (đạt toàn bộ) | PARTIAL (đạt một phần) | FAIL (không đạt)
model AcceptanceRecord {
  id                      String   @id @default(cuid())
  projectId               String
  reportId                String   @unique
  recordNumber            String // số biên bản (vd 12/BB-NT-XTTM)
  recordDate              DateTime
  result                  String // PASS | PARTIAL | FAIL
  comments                String? // ghi chú nghiệm thu
  scannedFileUrl          String? // path bản scan đã ký
  liquidationDate         DateTime? // ngày thanh lý HĐ (nếu đã thanh lý)
  liquidationFileUrl      String? // bản scan biên bản thanh lý
  createdById             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  report  Report  @relation(fields: [reportId], references: [id])

  @@index([projectId])
  @@index([result])
}

// =============================================================================
// FINANCIAL RECORD — Phase 9 (M5) Tạm ứng / Thanh toán / Quyết toán
// =============================================================================

// Phase 9 (M5) — Hồ sơ tài chính theo dõi tạm ứng + thanh toán + quyết toán.
// recordType: ADVANCE (tạm ứng sau ký HĐ) | PAYMENT (thanh toán sau nghiệm thu) | SETTLEMENT (quyết toán cuối kỳ)
// status: DRAFT → SUBMITTED → APPROVED → DISBURSED | SETTLED
// amount: số tiền VND (SQLite REAL)
model FinancialRecord {
  id              String    @id @default(cuid())
  projectId       String
  contractId      String?
  recordType      String // ADVANCE | PAYMENT | SETTLEMENT
  recordNumber    String? // số phiếu (vd 12/PT-XTTM)
  amount          Float
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | DISBURSED | SETTLED
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  disbursedAt     DateTime? // ngày chi trả thực tế
  transactionDate DateTime? // ngày giao dịch thực tế trên sổ
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([contractId])
  @@index([recordType, status])
  @@index([transactionDate])
}

// =============================================================================
// ATTACHMENT — Polymorphic, used từ M0+ cho mọi entity
// =============================================================================

model Attachment {
  id            String    @id @default(cuid())
  entityType    String // Project | Contract | Report | ProgramCycle | OrganizationProfile
  entityId      String
  fileName      String
  fileUrl       String // path in storage/uploads/ or public/mock-files/
  fileSize      Int?
  mimeType      String?
  // Công văn metadata (CYCLE-07) — chỉ populate khi entityType=ProgramCycle và là công văn ban hành
  signedNumber  String? // số công văn (vd: 1234/CV-XTTM)
  signedDate    DateTime? // ngày ký công văn
  signedByName  String? // họ tên người ký
  signedByTitle String? // chức vụ người ký
  uploadedById  String
  createdAt     DateTime  @default(now())

  uploader User @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
}

// =============================================================================
// AUDIT LOG — M1 scaffolding, write từ M0 (every server action mutation)
// =============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | TRANSITION | SUBMIT | APPROVE
  resource   String // Project | ProgramCycle | Contract | Report | User | ...
  resourceId String?
  diffJson   String? // before/after JSON
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
}

// =============================================================================
// CATALOGS — M1 (Phase 2 plan 02-02)
// 8 master data tables phục vụ dropdown options cho mọi phase nghiệp vụ.
// CAT-01..08: ProjectKind, IndustrySector, Market, PromotionType, Country,
// OrgUnit, ScoringCriterion, DocumentTemplate.
// Common pattern: code unique, name VN, searchKey diacritics-removed,
// displayOrder int, isActive bool soft-deactivate.
// =============================================================================

// CAT-01: Loại đề án — 8 records seed (EXPORT_EXHIBITION, INTL_CONFERENCE, ...)
model ProjectKind {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  searchKey    String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([searchKey])
  @@index([isActive, displayOrder])
}

// CAT-02: Ngành hàng — 20 records (TEXTILE, FOOTWEAR, WOOD, ...)
model IndustrySector {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  searchKey    String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([searchKey])
  @@index([isActive, displayOrder])
}

// CAT-03: Thị trường — 15 records, region-grouped (EU, US, CHINA, JAPAN, ...)
model Market {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  nameEn       String?
  region       String // EUROPE | ASIA | AMERICAS | AFRICA | OCEANIA
  description  String?
  searchKey    String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([searchKey])
  @@index([isActive, displayOrder])
  @@index([region])
}

// CAT-04: Loại hình XTTM — 8 records (TRADE_FAIR, BUSINESS_MATCHING, ...)
model PromotionType {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  searchKey    String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([searchKey])
  @@index([isActive, displayOrder])
}

// CAT-05: Quốc gia — 30 records ISO alpha-3 (VNM, USA, CHN, JPN, ...)
model Country {
  id             String   @id @default(cuid())
  code           String   @unique // ISO 3166-1 alpha-3
  name           String
  nameEn         String?
  region         String // EUROPE | ASIA | AMERICAS | AFRICA | OCEANIA
  hasTradeOffice Boolean  @default(false) // Có thương vụ Việt Nam tại đó?
  description    String?
  searchKey      String   @default("")
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([searchKey])
  @@index([isActive, displayOrder])
  @@index([region])
}

// CAT-06: Đơn vị — 12 records, hierarchical (BO_CT → CUC_XTTM, VINATEX → MAY10)
model OrgUnit {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         String // MINISTRY | DEPARTMENT | ASSOCIATION | ENTERPRISE | RESEARCH_INSTITUTE | OTHER
  parentId     String?
  description  String?
  searchKey    String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent   OrgUnit?  @relation("OrgUnitParent", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitParent")

  @@index([searchKey])
  @@index([isActive, displayOrder])
  @@index([type])
  @@index([parentId])
}

// CAT-07: Tiêu chí chấm điểm — 15 records, hierarchical (4 group + 11 children)
// weight Float (sum group = 100), appliesToKinds JSON of ProjectKind.code
model ScoringCriterion {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  weight         Float    @default(0) // 0-100
  appliesToKinds String? // JSON array of ProjectKind.code values, e.g. ["EXPORT_EXHIBITION","INTL_CONFERENCE"]
  parentId       String?
  searchKey      String   @default("")
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   ScoringCriterion?  @relation("ScoringCriterionParent", fields: [parentId], references: [id])
  children ScoringCriterion[] @relation("ScoringCriterionParent")

  @@index([searchKey])
  @@index([isActive, displayOrder])
  @@index([parentId])
}

// CAT-08: Mẫu văn bản — 6 records Tiptap HTML (CONG_VAN_MOI, TO_TRINH, ...)
model DocumentTemplate {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  category     String // CONG_VAN_MOI | TO_TRINH | QUYET_DINH | HOP_DONG | BIEN_BAN_NGHIEM_THU | THANH_LY
  description  String?
  bodyHtml     String // Tiptap HTML output
  variables    String? // JSON array of placeholder names, e.g. ["tenChuongTrinh","namKy"]
  searchKey    String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([searchKey])
  @@index([isActive, displayOrder])
  @@index([category])
}

// =============================================================================
// SYSTEM CONFIG — M1 (Phase 2 plan 02-07)
// Key-value JSON store cho:
//   - "sla.params" — SLA thresholds (CONFIG-01)
//   - "email.template.{KEY}" — 5 email templates (CONFIG-02)
//   - "sms.template.{KEY}" — 3 SMS templates (CONFIG-02)
// Phase 3+ consume qua lib/system-config.ts cached helpers.
// =============================================================================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  valueJson   String // JSON string
  category    String // SLA | EMAIL | SMS
  label       String // Vietnamese human-readable label
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// =============================================================================
// NOTIFICATION + DISPATCH — Phase 3 (M2.1 CYCLE-13 mock dispatch)
// Mock email/in-app dispatch system. KHÔNG gửi email thật — chỉ lưu records để
// inbox UI (Phase 4) render. Pattern: 1 Notification (parent) + N Dispatches.
// =============================================================================

model Notification {
  id             String   @id @default(cuid())
  programCycleId String?
  projectId      String?
  type           String // CYCLE_INVITATION | CYCLE_CONFIG_CHANGED | CYCLE_EXTENDED | CYCLE_OPENED | CYCLE_CLOSED
  subject        String
  content        String // HTML body (Tiptap output)
  recipientType  String   @default("ORGANIZATION") // ORGANIZATION | USER | ROLE
  createdById    String
  createdAt      DateTime @default(now())

  programCycle ProgramCycle?          @relation(fields: [programCycleId], references: [id], onDelete: Cascade)
  dispatches   NotificationDispatch[]

  @@index([programCycleId])
  @@index([type])
  @@index([createdAt])
}

model NotificationDispatch {
  id              String    @id @default(cuid())
  notificationId  String
  recipientUserId String?
  recipientOrgId  String?
  status          String    @default("SENT") // PENDING | SENT | READ | FAILED
  sentAt          DateTime  @default(now())
  readAt          DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([recipientUserId])
  @@index([recipientOrgId])
  @@index([status])
}
